<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zjw.gmbackend.mapper.UserMapper">

    <select id="findByUsername" resultType="com.zjw.gmbackend.pojo.User">
        select
            id,
            username,
            password,
            nickname,
            avatar_url as avatarUrl,
            role,
            created_time as createdTime
        from user
        where username = #{username}
            limit 1
    </select>

</mapper>
